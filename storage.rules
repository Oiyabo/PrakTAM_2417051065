rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /events/{clusterName}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (
        !firestore.exists(/databases/(default)/documents/eventClusters/$(clusterName)) ||
        firestore.get(/databases/(default)/documents/eventClusters/$(clusterName)).data.owner == request.auth.uid
      );
    }
  }
}
